{
  "openapi": "3.1.0",
  "info": {
    "title": "ENEM Aberto — API de Visualizações",
    "description": "Catálogo de visualizações interativas, tópicos do ENEM, moléculas e camadas geográficas.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/chemistry/datasets/{name}": {
      "get": {
        "tags": [
          "crate::chemistry"
        ],
        "operationId": "get_dataset",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Nome do dataset químico versionado",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChemistryDatasetResponse"
                }
              }
            }
          },
          "404": {
            "description": "Dataset não encontrado"
          }
        }
      }
    },
    "/api/v1/chemistry/reactions/{id}": {
      "get": {
        "tags": [
          "crate::chemistry"
        ],
        "operationId": "get_reaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador da reação",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChemistryReactionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Reação não encontrada"
          }
        }
      }
    },
    "/api/v1/enem/topics": {
      "get": {
        "tags": [
          "crate::topics"
        ],
        "operationId": "list_topics",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/geo/layers/{layer}": {
      "get": {
        "tags": [
          "crate::geo"
        ],
        "operationId": "get_geo_layer",
        "parameters": [
          {
            "name": "layer",
            "in": "path",
            "description": "Slug da camada geográfica",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoLayerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Camada não encontrada"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "crate::health"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/molecules/{slug}": {
      "get": {
        "tags": [
          "crate::molecules"
        ],
        "operationId": "get_molecule",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Slug da molécula",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoleculeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Molécula não encontrada"
          }
        }
      }
    },
    "/api/v1/subjects": {
      "get": {
        "tags": [
          "crate::subjects"
        ],
        "operationId": "list_subjects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visualizations": {
      "get": {
        "tags": [
          "crate::visualizations"
        ],
        "operationId": "list_visualizations",
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "dimension",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "default": 12,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisualizationListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visualizations/{slug}": {
      "get": {
        "tags": [
          "crate::visualizations"
        ],
        "operationId": "get_visualization",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Slug único da visualização",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisualizationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Visualização não encontrada"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtomMappingSeed": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "AtomSeed": {
        "type": "object",
        "required": [
          "id",
          "element"
        ],
        "properties": {
          "element": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "ChemistryDatasetDto": {
        "type": "object",
        "required": [
          "name",
          "description",
          "conditions",
          "data",
          "sources"
        ],
        "properties": {
          "conditions": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ChemistryDatasetResponse": {
        "type": "object",
        "required": [
          "dataset"
        ],
        "properties": {
          "dataset": {
            "$ref": "#/components/schemas/ChemistryDatasetDto"
          }
        }
      },
      "ChemistryReactionResponse": {
        "type": "object",
        "required": [
          "reaction"
        ],
        "properties": {
          "reaction": {
            "$ref": "#/components/schemas/ReactionSeed"
          }
        }
      },
      "GeoLayerDto": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "geojson",
          "metadata",
          "sources",
          "level"
        ],
        "properties": {
          "geojson": {
            "type": "object"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GeoLayerResponse": {
        "type": "object",
        "required": [
          "layer"
        ],
        "properties": {
          "layer": {
            "$ref": "#/components/schemas/GeoLayerDto"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "MoleculeDto": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "formula",
          "atoms",
          "bonds",
          "metadata",
          "sources"
        ],
        "properties": {
          "atoms": {
            "type": "object"
          },
          "bonds": {
            "type": "object"
          },
          "formula": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MoleculeResponse": {
        "type": "object",
        "required": [
          "molecule"
        ],
        "properties": {
          "molecule": {
            "$ref": "#/components/schemas/MoleculeDto"
          }
        }
      },
      "ReactionSeed": {
        "type": "object",
        "required": [
          "id",
          "name",
          "classification",
          "equation",
          "species",
          "atomMapping",
          "stages",
          "enemTopics",
          "didacticNote",
          "sources"
        ],
        "properties": {
          "atomMapping": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AtomMappingSeed"
            }
          },
          "classification": {
            "type": "string"
          },
          "didacticNote": {
            "type": "string"
          },
          "enemTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "equation": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "species": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReactionSpeciesSeed"
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReactionStageSeed"
            }
          },
          "thermodynamics": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ThermodynamicsSeed"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReactionSpeciesSeed": {
        "type": "object",
        "required": [
          "side",
          "formula",
          "name",
          "state",
          "coefficient",
          "charge",
          "atoms"
        ],
        "properties": {
          "atoms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AtomSeed"
            }
          },
          "charge": {
            "type": "integer",
            "format": "int32"
          },
          "coefficient": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "formula": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "ReactionStageSeed": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "legend",
          "breakingBonds",
          "formingBonds"
        ],
        "properties": {
          "breakingBonds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formingBonds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "from": {
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "string"
          },
          "legend": {
            "type": "string"
          },
          "to": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SubjectDto": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "description"
