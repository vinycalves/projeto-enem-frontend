          "source"
        ],
        "properties": {
          "conditions": {
            "type": "string"
          },
          "deltaHKjMol": {
            "type": "number",
            "format": "double"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "TopicDto": {
        "type": "object",
        "required": [
          "id",
          "subject_code",
          "slug",
          "name",
          "sort_order"
        ],
        "properties": {
          "description": {
            "type": [
